    <!-- VIEW 2: CART PLACEHOLDER -->
    <section id="checkout-view" class="view-panel">
        <h2 class="section-title">Checkout Pipeline Empty</h2>
    </section>

    <!-- VIEW 3: INVISIBLE ENTRY GATEWAY -->
    <section id="login-gateway-view" class="view-panel">
        <div class="login-card" id="vault-key-step">
            <h3 style="font-family: var(--font-serif); font-size: 28px; margin-bottom: 10px;">Authorized Access Only</h3>
            <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">Please enter the master encryption key.</p>
            <form id="admin-vault-login-form">
                <input type="password" id="vaultKeyInput" class="input-box" placeholder="••••••••" style="text-align: center; font-size: 18px;" required>
                <button type="submit" class="cta-btn" style="width: 100%;">Verify Key Sequence</button>
            </form>
            <p id="login-error-msg" style="color: red; font-size: 13px; margin-top: 12px; display: none;">⚠️ Access Denied: Invalid Key Sequence</p>
        </div>

        <div class="login-card" id="vault-otp-step" style="display: none;">
            <h3 style="font-family: var(--font-serif); font-size: 28px; margin-bottom: 10px;">Two-Factor Validation</h3>
            <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">A verification code has been dispatched to your email configuration panel.</p>
            <form id="admin-otp-validation-form">
                <input type="text" id="vaultOtpInput" class="input-box" placeholder="000000" maxlength="6" style="text-align: center; font-size: 22px; letter-spacing: 6px; font-weight:700;" required>
                <button type="submit" class="cta-btn" style="width: 100%;">Confirm OTP Token</button>
            </form>
            <p id="otp-error-msg" style="color: red; font-size: 13px; margin-top: 12px; display: none;">⚠️ Invalid Security Pin Sequence</p>
        </div>
    </section>

    <!-- VIEW 4: SECURED INTERFACE CORE CONSOLE -->
    <section id="admin-view" class="view-panel">
        <div class="admin-dashboard">
            <aside class="admin-sidebar">
                <h3 style="font-family: var(--font-serif); font-size:24px; margin-bottom:30px;">fiha hub</h3>
                <div class="admin-menu-item active">📦 Customer Orders</div>
            </aside>
            <main class="admin-main">
                <h3>Live Workspace Shield Active</h3>
                <p style="margin-top:10px; color:var(--text-muted);">Welcome back. Your hidden vault management module is fully online.</p>
            </main>
        </div>
    </section>

