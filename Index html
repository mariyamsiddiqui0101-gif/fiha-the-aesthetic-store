        </nav>
    </header>

    <!-- VIEW 1: STOREFRONT -->
    <main id="storefront-view" class="view-panel active">
        <section class="hero">
            <div class="hero-text">
                <h1>Pinterest-inspired finds, made for every occasion.</h1>
                <p>Handcrafted hampers, personalized stationery, and cozy artwork packed by hand in Lucknow.</p>
                <a href="#catalog" class="cta-btn">Explore Collection ✨</a>
            </div>
            <div style="flex: 1; text-align: right;">
                <div style="background: linear-gradient(135deg, #ffb7c5, #fbf9f6); width: 100%; max-width: 450px; height: 400px; display: inline-block; border-radius: 24px;"></div>
            </div>
        </section>
        <h2 id="catalog" class="section-title">Handpicked Top Selections</h2>
        <div class="grid-container" id="product-catalog-grid"></div>
