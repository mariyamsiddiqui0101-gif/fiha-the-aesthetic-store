    <div class="promo-bar">🎀 FREE SHIPPING ON PREMIUM BUNDLES OVER ₹999 | UPI SECURE STOREFRONT</div>

    <header>
        <!-- Tapping this logo 5 times sequentially launches the portal handshake -->
        <a href="#" class="logo" onclick="handleLogoClick(event)">fiha</a>
        <nav>
            <a onclick="switchView('storefront-view')">Shop All</a>
